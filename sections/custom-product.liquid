{{ 'custom-event-section.css' | asset_url | stylesheet_tag }}
<div class="custom-event-section">
  <div class="custom-event-section__left">
    {% for block in section.blocks %}
      {% if block.type == 'product_image' %}
        {% if product.featured_image %}
          <img 
            src="{{ product.featured_image | image_url: width: 600 }}" 
            width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
            alt="{{ product.title | escape }}">
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
  <div class="custom-event-section__right">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'product_title' %}
          <h1 class="event-title">{{ product.title }}</h1>
        {% when 'product_description' %}
          <div class="event-description">{{ product.description }}</div>
        {% when 'product_price' %}
          <div class="event-price" id="event-price">
            {{ product.selected_or_first_available_variant.price | money }}
          </div>
        {% when 'variant_selector' %}
        {% if product.variants.size > 1 %}
           <script id="variants-data" type="application/json">
            [
              {% for variant in product.variants %}
                {
                  "id": {{ variant.id }},
                  "available": {{ variant.available | json }},
                  "price": "{{ variant.price | money }}"{% for i in (1..product.options.size) %}{% assign opt = 'option' | append: i %},
                  "{{ opt }}": "{{ variant[opt] | escape }}"{% endfor %}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          </script>
          <div class="custom-variant-picker">
            {% for option in product.options_with_values %}
              {% assign opt_idx = forloop.index0 %}
              <div class="variant-group" data-option-index="{{ opt_idx }}">
                <div class="variant-group-label">{{ option.name }}</div>
                <div class="variant-options">
                  {% for value in option.values %}
                    <button
                      type="button"
                      class="variant-btn{% if forloop.first %} active{% endif %}"
                      data-option-index="{{ opt_idx }}"
                      data-value="{{ value | escape }}"
                      {% if forloop.first %}data-default="true"{% endif %}
                    >{{ value }}</button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
.
        {% endif %} 
        
        {% when 'checkout_form' %}
          <form id="event-form" class="event-form" autocomplete="off">
            <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}">
        
            {% if block.settings.show_customer_form %}
              <div class="form-row"><input type="text" name="properties[First name]" required placeholder="Ім’я"></div>
              <div class="form-row"><input type="text" name="properties[Last name]" required placeholder="Прізвище*"></div>
              <div class="form-row"><input type="email" name="properties[Email]" required placeholder="Емейл адреса*"></div>
              <div class="form-row"><input type="tel" name="properties[Phone]" required placeholder="Номер телефону*" імейл адреси></div>
              <div class="form-row"><input type="text" name="properties[Postal code]" required placeholder="Поштовий код*"></div>
              <div class="form-row"><label>Дата народження*</label><input type="date" name="properties[Birth date]" required></div>
              <div class="form-row"><label>Стать*</label>
                <select name="properties[Gender]" required >
                  <option value="">Обери...</option>
                  <option>Чоловіча</option>
                  <option>Жіноча</option>
                  <option>Інше</option>
                </select>
              </div>
              <div class="form-row"><input type="text" name="properties[User code]" placeholder="Код користувача"></div>
            {% endif %}
        
            <div id="event-form-error" class="error" style="display:none;"></div>
            <button class="event-btn" type="submit" id="event-buy-btn">Купити</button>
          </form>
      {% endcase %}
    {% endfor %}
  </div>
</div>
{{ 'custom-event-section.js' | asset_url | script_tag }}
{% schema %}
{
  "name": "Custom Event Product",
  "tag": "section",
  "settings": [],
  "blocks": [
    { "type": "product_image", "name": "Product image", "limit": 1 },
    { "type": "product_title", "name": "Title", "limit": 1 },
    { "type": "product_description", "name": "Description", "limit": 1 },
    { "type": "product_price", "name": "Price", "limit": 1 },
    { "type": "variant_selector", "name": "Variant selector", "limit": 1 },
    { "type": "checkout_form", 
      "name": "Checkout form", 
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_customer_form",
          "label": "Show customer form",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Custom Event Product" }]
}
{% endschema %}
